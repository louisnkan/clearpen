{
  "version": 2,
  "routes": [
    {
      "src": "/api/refine",
      "dest": "/api/refine.js"
    },
    {
      "src": "/api/webhook",
      "dest": "/api/webhook.js"
    },
    {
      "src": "/(.*)",
      "dest": "/clearpen.html"
    }
  ],
  "functions": {
    "api/refine.js": {
      "maxDuration": 30
    },
    "api/webhook.js": {
      "maxDuration": 10
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ]
}
